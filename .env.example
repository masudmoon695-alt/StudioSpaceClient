# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git. Never commit real secrets.

# Express API base URL used by the client. Must be browser-readable.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Better Auth, used by the auth route handler in this app.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# MongoDB connection string for the Better Auth adapter.
MONGODB_URI=

# Google social login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# imgbb key for studio image uploads (public).
NEXT_PUBLIC_IMGBB_KEY=
